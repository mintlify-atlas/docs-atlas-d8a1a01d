  "keyFeatures": [
    "Single `generateObject()` function works across 12 LLM providers",
    "Automatic return type inference from JSON schema via `InferFormat<T>`",
    "Tool-calling strategy forces structured output on providers lacking native `response_format` support",
    "JSON repair via `jsonrepair` and up to 5 automatic retries on malformed output",
    "Schema validation of required fields before returning results",
    "Multimodal support: attach base64 images to messages",
    "`generateText()` for plain-text completions using the same unified API",
    "Zero boilerplate: no per-provider client setup required"
  ],
  "publicApiSurface": [
    "generateObject(inferenceName, params, model, apiKey?): Promise<InferFormat<F>>",
    "generateText(inferenceName, params, model, apiKey?): Promise<string>",
    "InferenceName (enum: GPT5Inference, ClaudeInference, DeepseekInference, GrokInference, MistralInference, PerplexityInference, CohereInference, AlibabaInference, HfInference, OllamaInference, GLM4Inference, GroqInference)",
    "IOutlineParams<F> (interface: { format: F; messages: MessageModel[] })",
    "ITextParams (interface: { messages: MessageModel[] })",
    "FormatModel (interface: { type, required, properties })",
    "FormatProperty (discriminated union by type: string | number | integer | boolean | array | object)",
    "FormatItems (array item schema type)",
    "InferFormat<T extends FormatModel> (mapped type)",
    "MessageModel (interface: { role, content, images? })",
    "MessageRole (type: 'assistant' | 'system' | 'user')",
    "validateToolArguments(parsedArguments, schema): ValidationResult<T>",
    "validateValue(value, schema, path): string | null",
    "typeOf(value): string",
    "toOpenAIMessages(messages): OpenAI-compatible message array",
    "toOllamaMessages(messages): Ollama-compatible message array",
    "toDataUrl(image, mimeType?): string",
    "stripDataUrl(image): string"
  ]
}
